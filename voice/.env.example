# npm run configure creates a shared random local secret in the two .env.local files.
VOICE_CONTROL_SECRET=
VOICE_LISTEN_ADDRESS=127.0.0.1
VOICE_PORT=9100
VOICE_CONTROL_ADDRESS=127.0.0.1
VOICE_CONTROL_PORT=9101
VOICE_MEDIA_ADDRESS=0.0.0.0
# Set a non-loopback IPv4 address reachable by the browser. configure detects one.
# VOICE_ANNOUNCED_ADDRESS=192.168.1.100
VOICE_MEDIA_PORT=44400
# Production only: comma-separated exact frontend origins.
# VOICE_ALLOWED_ORIGINS=https://midnightmachinations.net
# Optional TURN servers, supplied to authenticated browsers at runtime.
# VOICE_ICE_SERVERS=[{"urls":"turn:turn.example.com:3478","username":"...","credential":"..."}]
